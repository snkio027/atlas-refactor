{
  "fullnameOverride": "sealed-secrets",
  "namespace": "atlas-secrets",
  "nodeSelector": {
    "kubernetes.io/os": "linux",
    "node-role.local/compute": "true"
  },
  "resources": {
    "requests": {
      "cpu": "20m",
      "memory": "64Mi"
    },
    "limits": {
      "memory": "192Mi"
    }
  },
  "metrics": {
    "serviceMonitor": {
      "enabled": false
    }
  },
  "keyrenewperiod": "0",
  "additionalNamespaces": [
    "atlas-secrets",
    "atlas-monitoring",
    "atlas-storage",
    "workload-web"
  ],
  "rbac": {
    "create": true,
    "clusterRole": false,
    "namespacedRoles": true
  }
}
