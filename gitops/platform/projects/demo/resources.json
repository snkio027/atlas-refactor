{
  "apiVersion": "v1",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        },
        "labels": {
          "atlas.io/gateway-access": "development",
          "atlas.io/project": "demo",
          "pod-security.kubernetes.io/enforce": "restricted"
        },
        "name": "demo"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ResourceQuota",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        },
        "name": "project-budget",
        "namespace": "demo"
      },
      "spec": {
        "hard": {
          "limits.cpu": "2",
          "limits.memory": "2Gi",
          "persistentvolumeclaims": "0",
          "pods": "6",
          "requests.cpu": "1",
          "requests.memory": "1Gi"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "LimitRange",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        },
        "name": "defaults",
        "namespace": "demo"
      },
      "spec": {
        "limits": [
          {
            "default": {
              "cpu": "500m",
              "memory": "256Mi"
            },
            "defaultRequest": {
              "cpu": "100m",
              "memory": "128Mi"
            },
            "type": "Container"
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        },
        "name": "default-deny",
        "namespace": "demo"
      },
      "spec": {
        "podSelector": {},
        "policyTypes": [
          "Ingress",
          "Egress"
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        },
        "name": "allow-dns",
        "namespace": "demo"
      },
      "spec": {
        "egress": [
          {
            "ports": [
              {
                "port": 53,
                "protocol": "UDP"
              },
              {
                "port": 53,
                "protocol": "TCP"
              }
            ],
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kube-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "k8s-app": "kube-dns"
                  }
                }
              }
            ]
          }
        ],
        "podSelector": {
          "matchLabels": {}
        },
        "policyTypes": [
          "Egress"
        ]
      }
    },
    {
      "apiVersion": "v1",
      "automountServiceAccountToken": false,
      "kind": "ServiceAccount",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        },
        "name": "unbound",
        "namespace": "demo"
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        },
        "name": "gateway-unbound",
        "namespace": "demo"
      },
      "spec": {
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "envoy-gateway-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "gateway.envoyproxy.io/owning-gateway-name": "development",
                    "gateway.envoyproxy.io/owning-gateway-namespace": "atlas-gateway"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 8080,
                "protocol": "TCP"
              }
            ]
          }
        ],
        "podSelector": {
          "matchLabels": {
            "atlas.io/project": "demo",
            "atlas.io/workload": "unbound"
          }
        },
        "policyTypes": [
          "Ingress"
        ]
      }
    },
    {
      "apiVersion": "v1",
      "automountServiceAccountToken": false,
      "kind": "ServiceAccount",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        },
        "name": "web-api",
        "namespace": "demo"
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        },
        "name": "gateway-web-api",
        "namespace": "demo"
      },
      "spec": {
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "envoy-gateway-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "gateway.envoyproxy.io/owning-gateway-name": "development",
                    "gateway.envoyproxy.io/owning-gateway-namespace": "atlas-gateway"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 8080,
                "protocol": "TCP"
              }
            ]
          }
        ],
        "podSelector": {
          "matchLabels": {
            "atlas.io/project": "demo",
            "atlas.io/workload": "web-api"
          }
        },
        "policyTypes": [
          "Ingress"
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        },
        "name": "metrics-web-api",
        "namespace": "demo"
      },
      "spec": {
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "atlas-monitoring"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "prometheus"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 8080,
                "protocol": "TCP"
              }
            ]
          }
        ],
        "podSelector": {
          "matchLabels": {
            "atlas.io/project": "demo",
            "atlas.io/workload": "web-api"
          }
        },
        "policyTypes": [
          "Ingress"
        ]
      }
    }
  ],
  "kind": "List"
}
