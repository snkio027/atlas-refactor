{
  "apiVersion": "v1",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        },
        "labels": {
          "atlas.io/gateway-access": "development",
          "atlas.io/project": "archive",
          "pod-security.kubernetes.io/enforce": "restricted"
        },
        "name": "archive"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ResourceQuota",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        },
        "name": "project-budget",
        "namespace": "archive"
      },
      "spec": {
        "hard": {
          "limits.cpu": "4",
          "limits.memory": "2Gi",
          "persistentvolumeclaims": "0",
          "pods": "8",
          "requests.cpu": "1",
          "requests.memory": "1Gi"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "LimitRange",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        },
        "name": "defaults",
        "namespace": "archive"
      },
      "spec": {
        "limits": [
          {
            "default": {
              "cpu": "500m",
              "memory": "256Mi"
            },
            "defaultRequest": {
              "cpu": "100m",
              "memory": "128Mi"
            },
            "type": "Container"
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        },
        "name": "default-deny",
        "namespace": "archive"
      },
      "spec": {
        "podSelector": {},
        "policyTypes": [
          "Ingress",
          "Egress"
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        },
        "name": "allow-dns",
        "namespace": "archive"
      },
      "spec": {
        "egress": [
          {
            "ports": [
              {
                "port": 53,
                "protocol": "UDP"
              },
              {
                "port": 53,
                "protocol": "TCP"
              }
            ],
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kube-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "k8s-app": "kube-dns"
                  }
                }
              }
            ]
          }
        ],
        "podSelector": {
          "matchLabels": {}
        },
        "policyTypes": [
          "Egress"
        ]
      }
    },
    {
      "apiVersion": "v1",
      "automountServiceAccountToken": false,
      "kind": "ServiceAccount",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        },
        "name": "experiment-archive",
        "namespace": "archive"
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        },
        "name": "gateway-experiment-archive",
        "namespace": "archive"
      },
      "spec": {
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "envoy-gateway-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "gateway.envoyproxy.io/owning-gateway-name": "development",
                    "gateway.envoyproxy.io/owning-gateway-namespace": "atlas-gateway"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 8080,
                "protocol": "TCP"
              }
            ]
          }
        ],
        "podSelector": {
          "matchLabels": {
            "atlas.io/project": "archive",
            "atlas.io/workload": "experiment-archive"
          }
        },
        "policyTypes": [
          "Ingress"
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        },
        "name": "metrics-experiment-archive",
        "namespace": "archive"
      },
      "spec": {
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "atlas-monitoring"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "prometheus"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 8080,
                "protocol": "TCP"
              }
            ]
          }
        ],
        "podSelector": {
          "matchLabels": {
            "atlas.io/project": "archive",
            "atlas.io/workload": "experiment-archive"
          }
        },
        "policyTypes": [
          "Ingress"
        ]
      }
    },
    {
      "apiVersion": "monitoring.coreos.com/v1",
      "kind": "ServiceMonitor",
      "metadata": {
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false"
        },
        "labels": {
          "release": "atlas-monitoring"
        },
        "name": "experiment-archive",
        "namespace": "archive"
      },
      "spec": {
        "endpoints": [
          {
            "interval": "30s",
            "path": "/metrics",
            "port": "http"
          }
        ],
        "namespaceSelector": {
          "matchNames": [
            "archive"
          ]
        },
        "selector": {
          "matchLabels": {
            "atlas.io/project": "archive",
            "atlas.io/workload": "experiment-archive"
          }
        }
      }
    }
  ],
  "kind": "List"
}
