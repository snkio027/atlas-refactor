{
  "apiVersion": "argoproj.io/v1alpha1",
  "kind": "AppProject",
  "metadata": {
    "name": "platform-project",
    "namespace": "argocd"
  },
  "spec": {
    "clusterResourceWhitelist": [
      {
        "group": "apiextensions.k8s.io",
        "kind": "CustomResourceDefinition"
      },
      {
        "group": "rbac.authorization.k8s.io",
        "kind": "ClusterRole"
      },
      {
        "group": "rbac.authorization.k8s.io",
        "kind": "ClusterRoleBinding"
      }
    ],
    "destinations": [
      {
        "namespace": "argocd",
        "server": "https://kubernetes.default.svc"
      }
    ],
    "namespaceResourceWhitelist": [
      {
        "group": "argoproj.io",
        "kind": "Application"
      },
      {
        "group": "",
        "kind": "ConfigMap"
      },
      {
        "group": "",
        "kind": "Secret"
      },
      {
        "group": "",
        "kind": "Service"
      },
      {
        "group": "",
        "kind": "ServiceAccount"
      },
      {
        "group": "apps",
        "kind": "Deployment"
      },
      {
        "group": "apps",
        "kind": "StatefulSet"
      },
      {
        "group": "batch",
        "kind": "Job"
      },
      {
        "group": "networking.k8s.io",
        "kind": "NetworkPolicy"
      },
      {
        "group": "rbac.authorization.k8s.io",
        "kind": "Role"
      },
      {
        "group": "rbac.authorization.k8s.io",
        "kind": "RoleBinding"
      }
    ],
    "sourceRepos": [
      "https://github.com/snkio027/atlas-refactor.git"
    ]
  }
}
