{
  "apiVersion": "argoproj.io/v1alpha1",
  "kind": "Application",
  "metadata": {
    "annotations": {
      "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false",
      "argocd.argoproj.io/sync-wave": "-20"
    },
    "name": "project-bootstrap",
    "namespace": "argocd"
  },
  "spec": {
    "destination": {
      "namespace": "argocd",
      "server": "https://kubernetes.default.svc"
    },
    "project": "atlas-bootstrap",
    "source": {
      "path": "gitops/test/projects",
      "repoURL": "https://github.com/snkio027/atlas-refactor.git",
      "targetRevision": "integration-20260927-02"
    },
    "syncPolicy": {
      "automated": {
        "enabled": true,
        "prune": true,
        "selfHeal": true
      },
      "syncOptions": [
        "ServerSideApply=true",
        "ApplyOutOfSyncOnly=true"
      ]
    }
  }
}
