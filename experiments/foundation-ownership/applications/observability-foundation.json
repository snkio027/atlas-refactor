{
  "apiVersion": "argoproj.io/v1alpha1",
  "kind": "Application",
  "metadata": {
    "annotations": {
      "argocd.argoproj.io/sync-options": "Prune=confirm,Delete=false",
      "argocd.argoproj.io/sync-wave": "-100"
    },
    "name": "observability-foundation",
    "namespace": "argocd"
  },
  "spec": {
    "destination": {
      "namespace": "atlas-monitoring",
      "server": "https://kubernetes.default.svc"
    },
    "project": "platform-project",
    "source": {
      "path": "gitops/platform/foundation/observability/overlays/development",
      "repoURL": "https://github.com/snkio027/atlas-refactor.git",
      "targetRevision": "codex/ot1-desired-state"
    },
    "syncPolicy": {
      "syncOptions": [
        "ServerSideApply=true",
        "FailOnSharedResource=true"
      ]
    }
  }
}
